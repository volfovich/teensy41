{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAM Forge",
  "version": "0.1.0",
  "identifier": "com.volfovich.namforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Volfovich NAM Forge",
        "width": 1280,
        "height": 780,
        "minWidth": 1100,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
